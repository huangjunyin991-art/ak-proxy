[Unit]
Description=AK Proxy Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/ak-proxy

# Load environment variables from file (optional).
# Put NOTIFY_CENTER_INTERNAL_SECRET in /etc/ak-proxy.env
EnvironmentFile=-/etc/ak-proxy.env
# proxy_server imports the plugin namespace as a top-level package.
# Keep both the repository root and plugin root on the service import path.
Environment=PYTHONPATH=/home/ubuntu/ak-proxy/public_admin:/home/ubuntu/ak-proxy

# venv + run entrypoint
ExecStart=/home/ubuntu/ak-proxy/venv/bin/python -m public_admin.server.proxy_server
Restart=always
RestartSec=2

# Keep the process from hitting the distro default soft limit under the
# per-exit HTTP connection pools.  Code still retires unused generations.
LimitNOFILE=65536

# Hardening (keep minimal to avoid breaking existing behavior)
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
